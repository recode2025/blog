[Unit]
Description=Pull and publish the prebuilt blog from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/local/bin/blog-pull /var/www/blog https://github.com/recode2025/blog.git site
TimeoutStartSec=10min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/blog
