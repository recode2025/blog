# Copy to .env.deploy.local. Use an SSH config alias or user@hostname.
# Set up SSH key authentication and verify the host with ssh first.
DEPLOY_HOST=blog-server

# Nginx must serve DEPLOY_PATH/current. This directory must be writable
# by the SSH user; only generated public/ files are uploaded here.
DEPLOY_PATH=/var/www/blog

# Optional: omit to use ~/.ssh/config and your SSH agent.
# DEPLOY_SSH_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
